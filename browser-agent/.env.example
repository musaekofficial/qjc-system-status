# Anthropic API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# 모델과 생각 깊이. 기본값: claude-opus-5-5, high
# MODEL=claude-opus-5-5
# EFFORT=high

# 맥미니에 설치된 구글 크롬을 쓰려면 chrome (비우면 Playwright 전용 Chromium)
BROWSER_CHANNEL=chrome

# 비용 상한 (달러): 작업 하나 / 한 사람 하루 / 전체 하루
# LIMIT_TASK_USD=3
# LIMIT_USER_DAY_USD=15
# LIMIT_TOTAL_DAY_USD=30

# PORT=3080
